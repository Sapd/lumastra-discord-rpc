{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumastra Discord RPC",
  "version": "0.1.1",
  "identifier": "org.lumastra.discord-rpc",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lumastra Discord RPC",
        "width": 480,
        "height": 620,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
